#version 450
// HDR10 picture of the present (runtime/vk_hdr.c vk_hdr_encode), crop rectangle at offset of the window texture.
// MTF tonemaps its scene to SDR with ACES (Hill's fit): x = min((light + bloom) * exposure, 16384), per channel
// RRT+ODT fit of ACESInput * x, then ACESOutput, clamped to 0..1 and written to an sRGB target; the HUD is drawn after.
// Here, for each pixel: the same SDR value is computed again from the game's own inputs (the light target and the
// bloom it sampled, its exposure). Where the window texture holds exactly that value (the 8-bit sRGB code, to within
// rounding) the pixel is the scene, and it gets the HDR value: the same curve up to y_k, then a smooth roll-off (same
// value and slope at v_k) up to the display's peak instead of the curve's flat shoulder at 1. Anything else (the HUD,
// text, effects drawn after the tonemap, a scene the inputs no longer hold) keeps the window texture's SDR value at the
// HUD's white. Out: PQ code values in Rec. 2020 (SMPTE ST 2084; the matrix: ITU-R BT.2087), RGBA16F.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D win;     // the window texture through a UNORM view: its sRGB codes
layout(binding = 1) uniform sampler2D light;   // the tonemap's first input (the scene light target)
layout(binding = 2) uniform sampler2D bloom;   // its second input
layout(binding = 3, rgba16f) uniform writeonly image2D dst;
layout(push_constant) uniform P {
    ivec2 offset;
    ivec2 size;
    vec4 n;   // x: nits of the HUD's white, y: nits of the picture's white, z: the display's peak, w: exposure (0: no scene)
    vec4 k;   // x: v_k, y: y_k, z: the curve's slope at v_k, w: the peak relative to the picture's white
} pc;

const mat3 ACES_IN = mat3(0.59719, 0.07600, 0.02840, 0.35458, 0.90834, 0.13383, 0.04823, 0.01566, 0.83777);
const mat3 ACES_OUT = mat3(1.60475, -0.10208, -0.00327, -0.53108, 1.10813, -0.07276, -0.07367, -0.00605, 1.07602);
const mat3 TO_2020 = mat3(0.6274, 0.0691, 0.0164, 0.3293, 0.9195, 0.0880, 0.0433, 0.0114, 0.8956);

float aces_fit(float v) {
    return (v * (v + 0.0245786) - 0.000090537) / (v * (0.983729 * v + 0.4329510) + 0.238081);
}

float aces_hdr(float v) {
    if (v <= pc.k.x) return aces_fit(v);
    float room = pc.k.w - pc.k.y;
    return pc.k.y + room * (1.0 - exp(-pc.k.z * (v - pc.k.x) / room));
}

vec3 srgb_decode(vec3 c) {
    return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), greaterThan(c, vec3(0.04045)));
}

vec3 srgb_encode(vec3 l) {
    return mix(l * 12.92, 1.055 * pow(l, vec3(1.0 / 2.4)) - 0.055, greaterThan(l, vec3(0.0031308)));
}

vec3 pq(vec3 nits) {
    const float m1 = 0.1593017578125, m2 = 78.84375, c1 = 0.8359375, c2 = 18.8515625, c3 = 18.6875;
    vec3 y = pow(clamp(nits / 10000.0, 0.0, 1.0), vec3(m1));
    return pow((c1 + c2 * y) / (1.0 + c3 * y), vec3(m2));
}

void main() {
    ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(at, pc.size))) return;
    vec3 w = clamp(texelFetch(win, at + pc.offset, 0).rgb, 0.0, 1.0);
    vec3 lin = srgb_decode(w);
    vec3 nits = lin * pc.n.x;
    if (pc.n.w > 0.0) {
        vec2 uv = (vec2(at) + 0.5) / vec2(pc.size);
        vec3 x = min((texture(light, uv).rgb + texture(bloom, uv).rgb) * pc.n.w, vec3(16384.0));
        float luma = dot(max(x, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722));
        float scale = (luma > pc.k.x) ? (aces_hdr(luma) / max(aces_fit(luma), 1e-5)) : 1.0;
        nits = (lin * scale) * pc.n.y;
    }
    nits = min(max(TO_2020 * nits, vec3(0.0)), vec3(pc.n.z));
    imageStore(dst, at, vec4(pq(nits), 1.0));
}
